#!/bin/bash
set -euxo pipefail
exec > >(tee /var/log/user-data.log) 2>&1

# 1GBメモリでのビルド用にスワップを追加
fallocate -l 2G /swapfile
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
echo '/swapfile none swap sw 0 0' >> /etc/fstab

dnf install -y docker git
systemctl enable --now docker

mkdir -p /usr/local/lib/docker/cli-plugins
curl -SL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

git clone --branch ${branch} ${repo_url} /opt/app
cd /opt/app

# DBパスワードはリポジトリに残さず、SSM Parameter Store(SecureString)から取得する
DB_PASSWORD=$(aws ssm get-parameter --name "${db_password_param}" --with-decryption --region ${region} --query Parameter.Value --output text)
cat > .env <<ENV
DB_HOST=${db_host}
DB_NAME=${db_name}
DB_USERNAME=${db_username}
DB_PASSWORD=$DB_PASSWORD
ENV
chmod 600 .env

# buildxプラグインを入れていないため、classicビルダーを使う
export DOCKER_BUILDKIT=0
export COMPOSE_DOCKER_CLI_BUILD=0
docker compose -f docker-compose.prod.yml up -d --build
